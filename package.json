{
  "name": "digital-banking-experience-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dbel/member-web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "dev:operations": "npm run dev --workspace @dbel/operations-web",
    "mobile:start": "npm run start --workspace @dbel/mobile",
    "mobile:validate": "npm run validate:expo --workspace @dbel/mobile"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
