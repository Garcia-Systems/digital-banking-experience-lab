{
  "name": "digital-banking-experience-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dbel/member-web",
    "test": "npm run test --workspace @dbel/member-web",
    "lint": "npm run lint --workspace @dbel/member-web",
